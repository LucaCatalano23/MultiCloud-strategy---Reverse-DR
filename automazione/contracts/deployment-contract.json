{
  "schemaVersion": 1,
  "application": {
    "name": "helios-desk",
    "publicApiBasePath": "/api/v1",
    "canonicalLabHost": "helpdesk.azienda.lan"
  },
  "kubernetes": {
    "applicationNamespace": "helios-desk",
    "identityNamespace": "helios-identity",
    "workloads": [
      {
        "name": "helios-web",
        "port": 8080,
        "healthPath": "/healthz",
        "public": true
      },
      {
        "name": "helios-bff",
        "port": 8000,
        "healthPath": "/health/ready",
        "public": true
      },
      {
        "name": "helios-ticket-service",
        "port": 8001,
        "healthPath": "/health/ready",
        "public": false
      },
      {
        "name": "helios-automation-service",
        "port": 8002,
        "healthPath": "/health/ready",
        "public": false
      }
    ]
  },
  "automation": {
    "function": "helpdesk-ticket-processor",
    "source": "apps/functions/ticket-processor/handler.py",
    "trigger": "POST /api/v1/tickets/{ticketId}/automation",
    "runtimes": {
      "primary": {
        "mode": "aws-lambda",
        "provider": "aws-lambda",
        "runtime": "aws-lambda-cloud",
        "artifact": "ecr-container-image"
      },
      "dr": {
        "mode": "lambda-dr",
        "provider": "lambda-dr",
        "runtime": "lambda-rie-onprem",
        "artifact": "configmap-mounted-source"
      }
    }
  },
  "secrets": {
    "consumption": "external-secrets-operator",
    "note": "Stesso meccanismo di consumo su entrambi i siti: cambia solo il backend, non i manifest dei workload.",
    "primary": {
      "backend": "aws-secrets-manager",
      "auth": "irsa-service-account",
      "granularity": "per-workload",
      "manifest": "infra/aws/kubernetes/external-secrets.yaml"
    },
    "dr": {
      "backend": "openbao",
      "node": "vault-openbao",
      "address": "https://vault.azienda.lan:8200",
      "auth": "kubernetes-service-account",
      "granularity": "per-namespace",
      "kvMount": "helios",
      "sealMode": "shamir",
      "autoUnseal": "systemd-local-keys",
      "autoUnsealActivation": "explicit-opt-in",
      "manifest": "infra/onprem/secrets/external-secrets.yaml"
    },
    "materializedSecrets": [
      "helios-desk/helios-app-database",
      "helios-desk/helios-bff-runtime",
      "helios-desk/helios-app-tls",
      "helios-identity/keycloak-postgres",
      "helios-identity/keycloak-bootstrap-admin",
      "helios-identity/helios-bff-oidc",
      "helios-identity/helios-dr-operator",
      "helios-identity/helios-identity-tls"
    ]
  },
  "observability": {
    "drMetrics": [
      {
        "metric": "backup.last_success",
        "producer": "infra/aws/kubernetes/backup-cronjob.yaml",
        "meaning": "rpo"
      },
      {
        "metric": "failover.last_promotion",
        "producer": "helpdesk-dr/ansible/playbooks/failover.yml",
        "meaning": "rto"
      }
    ],
    "store": "dr_telemetry",
    "reader": "helios-bff GET /api/v1/platform/status"
  },
  "identity": {
    "note": "Le application registration Entra sono create e gestite dal team identita' aziendale, fuori da questo repository: non esiste piu' uno stack Terraform che le produca. L'audience e' quindi un input esterno, non un output derivabile.",
    "audience": {
      "source": "external-entra-app-registration",
      "application": "demo-api-app",
      "value": "client-id-guid-della-app-registration-api",
      "note": "GUID del client ID, non l'identifier URI api://... : per gli access token v2 il claim aud e' il GUID della Web API."
    },
    "primary": {
      "provider": "entra-id",
      "flow": "authorization-code-pkce",
      "clientApplication": "demo-bff-app",
      "clientAuthentication": "private-key-jwt",
      "clientAuthenticationNote": "La policy aziendale vieta i client secret: il BFF si autentica sul token endpoint con una client assertion firmata dal certificato emesso per la app registration."
    },
    "dr": {
      "provider": "keycloak",
      "issuer": "https://auth.azienda.lan/realms/helios-desk",
      "clientAuthentication": "client-secret",
      "clientAuthenticationNote": "Keycloak DR resta su client secret: e' locale al sito ed emesso dal realm, non soggetto alla policy del tenant aziendale. Il metodo e' configurazione per sito (OIDC_CLIENT_AUTH_METHOD), non un branch nel codice.",
      "requiresOfflineIdentitySource": true
    },
    "permissions": [
      "tickets.read",
      "tickets.write",
      "automation.execute"
    ]
  },
  "sites": {
    "primary": {
      "platform": "aws",
      "orchestrator": "eks",
      "database": "rds-postgresql-single-az",
      "identityProvider": "entra-id"
    },
    "dr": {
      "platform": "on-prem",
      "orchestrator": "k3s",
      "database": "postgresql",
      "identityProvider": "keycloak",
      "applicationReplicasAtRest": 0,
      "promotionOrchestrator": "ansible"
    }
  }
}
