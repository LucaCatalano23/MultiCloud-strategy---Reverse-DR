# Configuration installed only on ansible-node. Keep config.lxc-lab.env local.
TERNA_DR_AUTO_FAILOVER_ENABLED=false
TERNA_CONTROLLER_FAILURE_THRESHOLD=3
TERNA_CONTROLLER_INTERVAL_SECONDS=120
TERNA_CONTROLLER_STATE_DIR=/var/lib/terna-static-dr

# Direct probe of the public primary. router-edge forwards to the resolver
# learned via WAN DHCP, bypassing server-dns even in DR mode without requiring
# direct access to a public DNS service from a corporate network.
TERNA_PRIMARY_PROBE_URL=https://www.terna.it/
TERNA_PUBLIC_DNS_RESOLVER=10.10.4.2

# The static endpoint is probed directly on the lab ingress, before DNS is
# changed. It must be served by the terna-static-dr Nginx pod.
TERNA_STATIC_HEALTH_URL=http://terna.it/health

TERNA_LXC_DNS_NODE=server-dns
TERNA_LXC_K3S_NODE=k3s-datacenter
TERNA_LXC_STATIC_NAMESPACE=terna-static-dr
TERNA_DNS_ZONE=terna.it
TERNA_DNS_TARGET_IP=10.10.3.10
TERNA_DNS_TTL_SECONDS=30
