clusterName: reverse-dr-poc
region: eu-south-1
vpcId: REPLACE_VPC_ID
replicaCount: 1
serviceAccount:
  create: false
  name: aws-load-balancer-controller
enableShield: false
enableWaf: false
enableWafv2: false
defaultTags:
  Project: reverse-dr
  Environment: poc
  ManagedBy: aws-load-balancer-controller
