# Copiare come config.env e mantenere il file locale fuori da Git.
# Le credenziali AWS statiche non appartengono piu a questo flusso: il primary
# usa IRSA e il sito DR non deve conservarle.
POSTGRES_PASSWORD=replace-with-a-random-lab-password

# Arming switch. Set true only after CLOUD_PROBE_MODE and its target have been
# verified from ansible-node; bootstrap otherwise refuses to start the service.
DR_AUTO_FAILOVER_ENABLED=false

# Cloud reale AWS, cert ACM validato: DNS name dell'ALB e TLS verificato.
# Recuperalo con `kubectl -n helios-desk get ingress helios-public` e sovrascrivi:
# CLOUD_PROBE_MODE=https
# CLOUD_TARGET_HOST=k8s-helios-xxxxxxxx.eu-west-1.elb.amazonaws.com
# DR_AUTO_FAILOVER_ENABLED=true
#
# Cloud reale AWS senza ACM pubblico ma con self-signed importato in ACM
# (preferito: l'edge resta HTTPS e il login __Host-* funziona). Punta anche a un
# IP diretto e rilassa la verifica del cert non attendibile:
# CLOUD_PROBE_MODE=https
# CLOUD_TARGET_HOST=<IP o DNS name dell'ALB>
# CLOUD_TARGET_INSECURE=true        # oppure CLOUD_TARGET_CA_FILE=/percorso/al/self-signed.crt
# DR_AUTO_FAILOVER_ENABLED=true
#
# Ultima spiaggia, nessun cert caricabile sull'ALB: probe HTTP diretto all'IP.
# Rompe il login utente (__Host-*), solo per probe/non-produzione; l'ALB deve
# servire HTTP senza ssl-redirect (vedi README):
# CLOUD_PROBE_MODE=http
# CLOUD_TARGET_HOST=<IP pubblico dell'ALB>
# CLOUD_TARGET_PORT=80
# DR_AUTO_FAILOVER_ENABLED=true
