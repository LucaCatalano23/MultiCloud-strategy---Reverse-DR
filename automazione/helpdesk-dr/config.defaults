LAB_DOMAIN="azienda.lan"
HELPDESK_FQDN="helpdesk.azienda.lan"

CLOUD_NET="cloud-net"
CLOUD_NET_CIDR="10.20.0.1/24"
CLOUD_K3S_NAME="cloud-k3s"
CLOUD_K3S_IP="10.20.0.10"

ONPREM_K3S_NAME="k3s-datacenter"
ONPREM_K3S_IP="10.10.3.10"

DNS_SERVER_NAME="server-dns"
DNS_SERVER_IP="10.10.2.53"
GIT_SERVER_NAME="git-server"
GIT_SERVER_IP="10.10.3.70"
ANSIBLE_NODE_NAME="ansible-node"

APP_NAMESPACE="helpdesk"
APP_REPOSITORY_NAME="helpdesk-dr.git"
APP_REPOSITORY_URL="git://10.10.3.70/helpdesk-dr.git"

POSTGRES_DB="helpdesk"
POSTGRES_USER="helpdesk"

BACKUP_DIR="/srv/helpdesk-backups"
BACKUP_RETENTION="144"
BACKUP_INTERVAL_MINUTES="10"
BACKUP_S3_BUCKET="reverse-dr-helpdesk-backups"
BACKUP_S3_PREFIX="postgres"
BACKUP_MIRROR_DIR="/srv/helpdesk-dr-mirror"
BACKUP_MIRROR_INTERVAL_MINUTES="10"

AWS_REGION="eu-west-1"
AWS_CLI_VERSION="latest"
EKS_CLUSTER_NAME="helpdesk-cloud"
LOCALSTACK_EKS_API_ENABLED="false"
HELPDESK_LAMBDA_FUNCTION_NAME="helpdesk-ticket-processor"

DR_CONTROLLER_INTERVAL_SECONDS="20"
DR_CONTROLLER_FAILURE_THRESHOLD="3"
DR_CONTROLLER_SUCCESS_THRESHOLD="2"
DR_CONTROLLER_MODE="watch"
DR_STATE_DIR="/var/lib/helpdesk-dr"
ONPREM_STANDBY_REPLICAS="1"
DR_REQUIRE_ANSIBLE_NODE="true"

ALLOW_LXC_WRITABLE_PROC_SYS="true"
