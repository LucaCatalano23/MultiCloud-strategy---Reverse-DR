apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: island-mode-egress
  namespace: reverse-dr
spec:
  podSelector:
    matchLabels:
      app: reverse-dr-app
  policyTypes: [Egress]
  egress:
    - to:
        - namespaceSelector:
            matchLabels:
              kubernetes.io/metadata.name: reverse-dr
      ports:
        - { protocol: TCP, port: 5432 }
        - { protocol: TCP, port: 9000 }
    - to:
        - ipBlock:
            cidr: "{{ datacenter_keycloak_ip }}/32"
      ports:
        - { protocol: TCP, port: 8080 }
    # L'egress Internet è consentito solo verso il proxy del router datacenter.
    - to:
        - ipBlock:
            cidr: 172.28.30.253/32
      ports:
        - { protocol: TCP, port: 3128 }
    - to:
        - namespaceSelector:
            matchLabels:
              kubernetes.io/metadata.name: kube-system
      ports:
        - { protocol: UDP, port: 53 }
        - { protocol: TCP, port: 53 }
