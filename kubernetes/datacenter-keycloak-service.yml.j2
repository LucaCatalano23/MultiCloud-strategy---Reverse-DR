apiVersion: v1
kind: Service
metadata:
  name: keycloak-datacenter
  namespace: reverse-dr
spec:
  ports:
    - name: http
      port: 8080
      targetPort: 8080
---
apiVersion: discovery.k8s.io/v1
kind: EndpointSlice
metadata:
  name: keycloak-datacenter
  namespace: reverse-dr
  labels:
    kubernetes.io/service-name: keycloak-datacenter
addressType: IPv4
ports:
  - name: http
    protocol: TCP
    port: 8080
endpoints:
  - addresses: ["{{ datacenter_keycloak_ip }}"]
    conditions:
      ready: true
